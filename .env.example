# OAuth-токен агентства, scope direct:api. Никогда не добавляйте .env в Git.
# Важно: приложение не загружает .env автоматически. Передайте значения через
# окружение оболочки или env-блок MCP-клиента.
YD_TOKEN=y0_...

# Логин агентства — нужен только чтобы понимать, чей это токен
YD_AGENCY_LOGIN=my-agency

# Белый список клиентских логинов. Пусто = любые.
# Страховка от того, что модель уйдёт не в тот кабинет.
YD_ALLOWED_LOGINS=

# Куда складывать выгрузки
YD_OUT_DIR=./out

# Директ разрешает 5 офлайн-отчётов в очереди на пользователя, берём 4 с запасом
YD_MAX_INFLIGHT=4

# Сколько строк отдавать прямо в ответе тула
YD_INLINE_ROWS=30

# Сколько ждать готовности офлайн-отчёта, секунд
YD_REPORT_DEADLINE=600

YD_SANDBOX=false
YD_LANG=ru

# report = только отчётность; campaign_setup = добавить подтверждаемое создание
# текстово-графических кампаний. По умолчанию и для рабочих токенов безопаснее report.
YD_MODE=report

# Недельный бюджет кампании по умолчанию, в валюте кабинета (не в микроединицах).
# Пусто = не подсказывать модели никакую сумму.
YD_DEFAULT_WEEKLY_BUDGET=
