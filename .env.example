# OAuth-токен агентства, scope direct:api. Никогда не добавляйте .env в Git.
# Важно: приложение не загружает .env автоматически. Передайте значения через
# окружение оболочки или env-блок MCP-клиента.
YD_TOKEN=y0_...

# Логин агентства — нужен только чтобы понимать, чей это токен
YD_AGENCY_LOGIN=my-agency

# Белый список клиентских логинов. Пусто = любые.
# Страховка от того, что модель уйдёт не в тот кабинет.
YD_ALLOWED_LOGINS=

# Куда складывать выгрузки
YD_OUT_DIR=./out

# Директ разрешает 5 офлайн-отчётов в очереди на пользователя, берём 4 с запасом
YD_MAX_INFLIGHT=4

# Сколько строк отдавать прямо в ответе тула
YD_INLINE_ROWS=30

# Сколько ждать готовности офлайн-отчёта, секунд
YD_REPORT_DEADLINE=600

YD_SANDBOX=false
YD_LANG=ru

# report = только чтение; campaign_setup = типизированный план, live preflight,
# одноразовое подтверждение, создание UnifiedCampaign и readback.
# По умолчанию и для рабочих токенов безопаснее report.
YD_MODE=report

# Недельный бюджет кампании по умолчанию, в валюте кабинета (не в микроединицах).
# Пусто = не подсказывать модели никакую сумму.
YD_DEFAULT_WEEKLY_BUDGET=

# Итоговый HTML после direct_campaign_apply всегда сохраняется локально как
# <YD_OUT_DIR>/<client_login>/create/index.html. Чтобы также публиковать его:
YD_CREATE_REPORT_SSH_HOST=
YD_CREATE_REPORT_REMOTE_ROOT=
YD_CREATE_REPORT_PUBLIC_BASE_URL=

# Списывать баллы Direct с агентства (Use-Operator-Units: true); по умолчанию false.
YD_USE_OPERATOR_UNITS=false
# Отдельный API Wordstat. Необязательный токен с доступом к api.wordstat.yandex.net.
# Если пусто, используется совместимый legacy Direct v4.
YD_WORDSTAT_TOKEN=
# Необязательный OAuth-токен Метрики для проверки существования/доступности счётчиков.
# Наличие счётчика в HTML не доказывает приём событий; GTM проверяется в браузере.
YD_METRIKA_TOKEN=
